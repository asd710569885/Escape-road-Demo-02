{
  "version": 2,
  "builds": [
    {
      "src": "comment-server/package.json",
      "use": "@vercel/node",
      "config": { "includeFiles": ["comment-server/**"] }
    },
    {
      "src": "Escape-road-main/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "Escape-road-main/dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/comment-server/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/Escape-road-main/$1"
    }
  ]
} 